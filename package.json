{
  "name": "nex32scan-web",
  "version": "0.1.0",
  "private": true,
  "description": "nex32scan — bilingual (EN/TH) read-only block explorer for the Nexus Architect testnet. Website-only workspace (explorer app + the two libraries it builds against).",
  "scripts": {
    "dev": "pnpm --filter @nexus/nex32scan dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint \"{apps,packages}/*/{src,test,script}/**/*.{ts,tsx,mjs}\" --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "turbo": "^2.3.4",
    "typescript-eslint": "^8.70.1"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  }
}
